<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_participant_row" android:layout_width="match_parent"
    android:layout_height="48dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp"
    android:paddingLeft="8dp" android:paddingRight="6dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_row_background">
    <TextView android:id="@+id/widget_participant_color" android:layout_width="5dp"
        android:layout_height="27dp" android:background="#208C75"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:paddingLeft="9dp" android:paddingRight="4dp">
        <TextView android:id="@+id/widget_participant_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="13sp" android:singleLine="true"
            android:ellipsize="end"/>
        <Chronometer android:id="@+id/widget_timer_elapsed" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#B8C9CD" android:textSize="11sp"
            android:format="%s" android:visibility="gone"/>
        <TextView android:id="@+id/widget_timer_idle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#8EA9AF"
            android:textSize="11sp" android:text="—"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_start_action" android:layout_width="37dp"
        android:layout_height="38dp" android:padding="10dp"
        android:src="@drawable/widget_play" android:background="@drawable/widget_button_start"
        android:contentDescription="@string/widget_start"/>
    <ImageView android:id="@+id/widget_stop_action" android:layout_width="37dp"
        android:layout_height="38dp" android:padding="10dp"
        android:src="@drawable/widget_stop" android:background="@drawable/widget_button_secondary"
        android:layout_marginStart="5dp" android:contentDescription="@string/widget_stop"/>
    <ImageView android:id="@+id/widget_event_action" android:layout_width="37dp"
        android:layout_height="38dp" android:padding="10dp"
        android:src="@drawable/widget_event" android:background="@drawable/widget_button_secondary"
        android:layout_marginStart="5dp" android:contentDescription="@string/widget_event"/>
</LinearLayout>